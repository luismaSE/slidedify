<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same as backup_rules.xml, for cloud backup and phone-to-phone transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="database" path="slidedify.db" />
        <include domain="database" path="slidedify.db-wal" />
        <include domain="database" path="slidedify.db-shm" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="database" path="slidedify.db" />
        <include domain="database" path="slidedify.db-wal" />
        <include domain="database" path="slidedify.db-shm" />
    </device-transfer>
</data-extraction-rules>
